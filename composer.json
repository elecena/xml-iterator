{
    "name": "elecena/xml-iterator",
    "description": "Memory efficient and fast XML parser with iterator interface",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Elecena\\XmlIterator\\": "src/"
        },
        "classmap": [
            "tests/"
        ]
    },
    "authors": [
        {
            "name": "Maciej Brencz",
            "email": "macbre@elecena.pl"
        }
    ],
    "require": {
      "ext-xml": "*",
      "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.3 || ^11.5",
        "friendsofphp/php-cs-fixer": "^3.22"
    },
    "scripts": {
        "test": "phpunit --testdox",
        "lint": [
            "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --verbose"
        ],
        "format": [
            "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --config=.php-cs-fixer.php"
        ]
    }
}
